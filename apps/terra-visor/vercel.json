{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/terra-estado.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/terra/estado",
      "destination": "/terra/estado/index.html"
    },
    {
      "source": "/terra/estado/",
      "destination": "/terra/estado/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/terra/estado",
      "permanent": false
    }
  ]
}
